# Required: Discord webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/example-token-placeholder

# Optional: Comma-separated sender addresses, domains, usernames, or display names to match. If unset, all senders match.
# Examples: root@example.com, unattended-upgrades, example.com
FILTER_SENDERS=

# Optional: Comma-separated subject keywords to match (case-insensitive).
# install.sh defaults this to unattended-upgrades; unset or empty matches all subjects.
# Examples: unattended-upgrades, apt-listchanges, Cron
FILTER_SUBJECT_KEYWORDS=

# Optional: Maximum body characters to include in the Discord embed excerpt (default: 1500)
MAX_BODY_CHARS=1500

# Optional: Bot display name in Discord (default: mail2hook)
DISCORD_USERNAME=mail2hook

# Optional: Server name override (precedence: SERVER_NAME > hostname parsed from email > socket.gethostname)
# Examples: web01, server01, production-db
SERVER_NAME=
